{{!
    @template editor_marklar/filemanager

    Embedded Moodle draft-area file manager.

    Example context (json):
    {
        "src": "https://example.com/lib/editor/marklar/manage.php?itemid=1",
        "title": "Manage files"
    }
}}
<iframe
    class="marklar-filemanager"
    data-region="marklar-filemanager"
    src="{{src}}"
    title="{{title}}"
></iframe>
